<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox fx:id="rootContainer" nodeOrientation="LEFT_TO_RIGHT" prefHeight="365.0" prefWidth="330.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
   <children>
      <HBox prefHeight="50.0" prefWidth="299.0" spacing="5.0">
         <children>
            <Button fx:id="btnEN" mnemonicParsing="false" onAction="#btnEN" prefWidth="75.0" text="English" />
            <Button fx:id="btnFR" mnemonicParsing="false" onAction="#btnFR" prefWidth="75.0" text="French" />
            <Button fx:id="btnJP" mnemonicParsing="false" onAction="#btnJA" prefWidth="75.0" text="Japanese" />
            <Button fx:id="btnIR" mnemonicParsing="false" onAction="#btnFA" prefWidth="75.0" text="Persian" />
         </children>
         <VBox.margin>
            <Insets bottom="5.0" />
         </VBox.margin>
      </HBox>
      <VBox prefHeight="100.0" prefWidth="100.0">
         <children>
            <Label fx:id="lblDistance" text="Distance (km)" />
            <TextField fx:id="txtDistance" prefHeight="25.0" prefWidth="306.0" />
         </children>
      </VBox>
      <VBox prefHeight="100.0" prefWidth="100.0">
         <children>
            <Label fx:id="lblConsumption" text="Fuel Consumption (L/100 km)" />
            <TextField fx:id="txtConsumption" prefHeight="25.0" prefWidth="306.0" />
         </children>
      </VBox>
      <VBox prefHeight="100.0" prefWidth="299.0">
         <children>
            <Label fx:id="lblPrice" text="Fuel Price (per liter)" />
            <TextField fx:id="txtPrice" prefHeight="25.0" prefWidth="306.0" />
         </children>
      </VBox>
      <Label fx:id="lblResult" text="Result:">
         <font>
            <Font size="14.0" />
         </font>
         <VBox.margin>
            <Insets bottom="5.0" />
         </VBox.margin>
      </Label>
      <AnchorPane prefWidth="299.0">
         <children>
            <Button fx:id="btnCalculate" mnemonicParsing="false" onAction="#onCalculateButton" text="Calculate" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" />
         </children>
      </AnchorPane>
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</VBox>
